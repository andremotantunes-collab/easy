{
  "name": "easy",
  "displayName": "Easy.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:contrast && npm run check:brand && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node --experimental-strip-types scripts/contrast-check.ts",
    "check:brand": "vitest run src/lib/brand.test.ts",
    "icons": "node scripts/gen-icons.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.545.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^28.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
